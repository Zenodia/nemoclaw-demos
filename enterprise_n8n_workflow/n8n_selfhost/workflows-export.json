","createdAt":"2026-05-29T10:50:27.116Z","id":"AeEl1fy7yvwHqFge","name":"Zenodia Charpy <zcharpy@nvidia.com>","type":"personal","icon":null,"description":null,"creatorId":"7215de40-63d8-4a78-a21b-7b7c6e93a84f"}}],"versionMetadata":{"name":null,"description":null}},{"updatedAt":"2026-05-29T12:58:51.000Z","createdAt":"2026-05-29T11:20:21.746Z","id":"mAPFaEvgygizLfaY","name":"Sub: Task Router","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"workflowInputs":{"values":[{"name":"task"}]}},"name":"Execute Workflow Trigger","type":"n8n-nodes-base.executeWorkflowTrigger","position":[0,0],"id":"a29b39f2-1921-4fb9-a9af-a52e1970314d","typeVersion":1.1},{"parameters":{"language":"javaScript","jsCode":"// Task Router: classify category + priority from the task text\nconst task = ($input.first().json.task || '').toString().toLowerCase();\nlet category = 'general';\nif (/utiliz|metric|analy|report|dashboard|gpu|cluster|telemetry/.test(task)) category = 'analytics';\nelse if (/deploy|release|rollout|ship|provision/.test(task)) category = 'deployment';\nelse if (/incident|outage|down|alert|page|sev/.test(task)) category = 'incident';\nelse if (/cost|budget|invoice|spend|finance|billing/.test(task)) category = 'finance';\nlet priority = 'medium';\nif (/\\b(critical|urgent|sev1|sev 1|outage|down)\\b/.test(task)) priority = 'critical';\nelse if (/\\b(high|asap|important)\\b/.test(task)) priority = 'high';\nelse if (/\\b(low|whenever|minor|backlog)\\b/.test(task)) priority = 'low';\nreturn [{ json: { category, priority } }];"},"name":"Classify Task","type":"n8n-nodes-base.code","position":[224,0],"id":"f141ad41-98a2-4714-9015-f056fd648cdb","typeVersion":2}],"connections":{"Execute Workflow Trigger":{"main":[[{"node":"Classify Task","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":true},"staticData":null,"meta":null,"pinData":{},"versionId":"2f8f0f7d-bddf-4cdb-899f-11b833b67442","activeVersionId":"2f8f0f7d