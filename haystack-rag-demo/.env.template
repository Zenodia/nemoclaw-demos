# ── Required ──────────────────────────────────────────────────────────────────
# nvapi-... — used for both inference and embeddings
NVIDIA_API_KEY=

# ── Inference (nemoclaw sandbox agent model) ───────────────────────────────────
# INFERENCE_MODEL: the model the sandbox agent uses at runtime for reasoning/tool-use.
#
# IMPORTANT: the OpenClaw agent reaches its tools through a "tool-search" /
# code-execution surface (openclaw.tools.search/describe/call). Llama-based
# models — including nvidia/llama-3.3-nemotron-super-49b and the 70b variants —
# mishandle this surface: they refuse ("restricted access"), claim only
# tool_search_code is available, or misfire (e.g. create a cron job) instead of
# running the skill. Use a Nemotron-3 model, which drives the skill reliably.
# Nemotron-3 sizes: nano-30b-a3b, super-120b-a12b, ultra-550b-a55b.
INFERENCE_PROVIDER_TYPE=nvidia
INFERENCE_PROVIDER_NAME=nvidia
INFERENCE_BASE_URL=https://integrate.api.nvidia.com/v1
INFERENCE_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Onboard model (optional) ─────────────────────────────────────────────────
# NEMOCLAW_ONBOARD_MODEL: used ONLY during nemoclaw onboard's sync verification
# smoke-test. Large models (550b+) time out during this check. Set this to a
# fast 49b model for onboard, and INFERENCE_MODEL to the real runtime model.
# install.sh patches the sandbox openclaw.json to INFERENCE_MODEL after onboard.
NEMOCLAW_ONBOARD_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ── OpenClaw chat model (optional) ───────────────────────────────────────────
# Model used by openclaw for the frontend chat interface.
# Set to nvidia/moonshotai/kimi-k2.6 if you want vision/image support.
OPENCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# ── Haystack RAG server model (optional) ─────────────────────────────────────
# Model used by haystack_rag_server.py for RAG answer generation.
# Defaults to nvidia/llama-3.3-nemotron-super-49b-v1.5 if not set.
#
# IMPORTANT: use a FAST, NON-REASONING model here. Reasoning models (e.g.
# nemotron-super / nemotron-ultra) can emit very long reasoning traces on the
# RAG prompt and time out the generation call (observed: 150s timeout vs ~3s
# for a non-reasoning model). meta/llama-3.3-70b-instruct is a good default.
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
