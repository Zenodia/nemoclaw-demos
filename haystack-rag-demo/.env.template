# ── Required ──────────────────────────────────────────────────────────────────
# nvapi-... — used for both inference and embeddings
NVIDIA_API_KEY=                          

# ── Inference (nemoclaw sandbox agent model) ───────────────────────────────────
# These configure the model the sandbox agent itself uses for reasoning.
# Defaults to NVIDIA NIM; override if using a different provider.
INFERENCE_PROVIDER_TYPE=nvidia
INFERENCE_PROVIDER_NAME=nvidia
INFERENCE_BASE_URL=https://integrate.api.nvidia.com/v1
INFERENCE_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ── OpenClaw chat model (optional) ───────────────────────────────────────────
# Model used by openclaw for the frontend chat interface.
# Defaults to nvidia/llama-3.3-nemotron-super-49b-v1.5 if not set.
# Set to nvidia/moonshotai/kimi-k2.6 if you want vision/image support.
OPENCLAW_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# ── Haystack RAG (optional overrides) ────────────────────────────────────────
# NVIDIA_CHAT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
